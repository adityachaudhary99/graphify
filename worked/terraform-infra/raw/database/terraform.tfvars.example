# Database Configuration Example
# Copy this file to terraform.tfvars and update with your values

project = "my-app"  # Must match project name from VPC module

# VPC ID from VPC module output
vpc_id = "vpc-xxxxxxxxxxxxxxxxx"

# Private DB subnet IDs from VPC module output
# Run: cd ../vpc && terraform output private_db_subnet_ids
private_db_subnet_ids = {
  dev     = "subnet-xxxxxxxxxxxxxxxxx"
  staging = "subnet-xxxxxxxxxxxxxxxxx"
  prod    = "subnet-xxxxxxxxxxxxxxxxx"
}

# RDS security group IDs from security-groups module output
# Run: cd ../security-groups && terraform output rds_security_group_ids
rds_security_group_ids = {
  dev     = "sg-xxxxxxxxxxxxxxxxx"
  staging = "sg-xxxxxxxxxxxxxxxxx"
  prod    = "sg-xxxxxxxxxxxxxxxxx"
}

# Database configuration
db_username = "postgres"
db_name     = "mydb"

# Database passwords (will be stored in Secrets Manager)
# IMPORTANT: Use strong, unique passwords for each environment
# These should be provided via environment variables or a .env file
# DO NOT commit actual passwords to version control

# Example .env file:
# DB_PASSWORD_DEV=YourSecurePassword123!
# DB_PASSWORD_STAGING=YourSecurePassword456!
# DB_PASSWORD_PROD=YourSecurePassword789!
