    end
    
    subgraph "Storage"
        Storage[gp3 Storage<br/>100GB-1TB<br/>Auto-scaling]
    end
    
    AppPool -->|All Queries| Primary
    Primary -.->|Sync Replication| Standby
    Primary --> Storage
    
    Backup[Automated Backups<br/>35 days retention]
    Primary -.-> Backup
    
    Monitor[Enhanced Monitoring<br/>Performance Insights]
    Primary -.-> Monitor
    
    style Primary fill:#FFB6C1,stroke:#ff0000,stroke-width:3px
    style Standby fill:#90EE90,stroke:#00ff00,stroke-width:2px
    style Storage fill:#87CEEB,stroke:#0066cc,stroke-width:2px
